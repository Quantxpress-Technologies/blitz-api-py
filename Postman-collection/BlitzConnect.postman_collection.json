  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set('authToken', json.data.accessToken);",
                  "    console.log('Token saved (' + json.data.accessToken.length + ' chars).');",
                  "} else {",
                  "    throw new Error('Login failed: ' + pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appKey\": \"{{appKey}}\",\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/api/app_login",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["api", "app_login"]
            }
          },
          "response": []
        }
      ]
    },
