          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correlationOrderId\": \"postman-{{$timestamp}}\",\n  \"quantity\": 1,\n  \"product\": \"MIS\",\n  \"tif\": \"GFD\",\n  \"price\": 11,\n  \"orderType\": \"LIMIT\",\n  \"symbol\": \"IDEA\",\n  \"exchangeSegment\": \"NSEFO\",\n  \"orderSide\": \"BUY\",\n  \"disclosedQuantity\": 0,\n  \"stopPrice\": 0,\n  \"clientId\": \"{{userId}}\",\n  \"tiF_GTD_Date\": \"\"\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/orders/placeOrder",
              "host": ["{{apiBaseUrl}}"],
