              "raw": "{\n  \"blitzOrderId\": {{blitzOrderId}},\n  \"modifiedOrderQuantity\": 2,\n  \"price\": 11.01,\n  \"orderType\": \"LIMIT\",\n  \"symbol\": \"IDEA\",\n  \"exchangeSegment\": \"NSEFO\",\n  \"disclosedQuantity\": 0,\n  \"stopPrice\": 0,\n  \"tif\": \"GFD\",\n  \"tiF_GTD_Date\": \"\"\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/orders/modifyOrder",
              "host": ["{{apiBaseUrl}}"],
              "path": ["orders", "modifyOrder"]
