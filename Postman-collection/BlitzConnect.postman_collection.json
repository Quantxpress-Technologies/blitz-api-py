      "type": "string",
      "description": "Your userId / clientId. Required by 1.1 Login. Fill this in."
    },
    {
      "key": "baseURL",
      "value": "https://uat.bull8.ai:7443",
      "type": "string",
      "description": "Single host for every service. Change only this to retarget UAT/prod/local - all base URLs below are derived from it. For local dev use http://localhost:5294 and set apiBaseUrl to {{baseURL}}/api/v1."
    },
    {
      "key": "gatewayBaseUrl",
      "value": "{{baseURL}}/api_gateway/v1",
      "type": "string",
      "description": "Auth Gateway. Issues the JWT at POST /api/app_login with {appKey, userId}."
    },
    {
      "key": "apiBaseUrl",
      "value": "{{baseURL}}/api_interactive/api/v1",
      "type": "string",
      "description": "Blitz-API (Interactive REST)."
    },
    {
      "key": "WsBaseUrl",
      "value": "wss://uat.bull8.ai:7443",
      "type": "string",
      "description": "WebSocket origin, same host as {{baseURL}} but with wss. Interactive is /api_interactive/ws?access_token=<JWT>; Market Data is /md-streaming/ws?key=<JWT>."
    },
    {
      "key": "wsHost",
      "value": "uat.bull8.ai:7443",
      "type": "string",
      "description": "Host part of {{WsBaseUrl}} only - no scheme, no port inside the path. WebSocket-Test-Script.py joins this with wsScheme, so keep them separate."
