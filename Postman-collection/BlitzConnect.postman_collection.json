            "url": {
              "raw": "{{apiBaseUrl}}/orders/cancelOrder?instrumentId={{instrumentId}}&exchangeSegment=NSECM&blitzOrderId={{blitzOrderId}}",
              "host": ["{{apiBaseUrl}}"],
              "path": ["orders", "cancelOrder"],
              "query": [
                {
                  "key": "instrumentId",
                  "value": "{{instrumentId}}"
                },
                {
                  "key": "exchangeSegment",
                  "value": "NSECM",
                  "description": "instrumentId 110010000014366 (IDEA) is on NSECM, not NSEFO"
                },
                {
                  "key": "symbol",
                  "value": "IDEA",
                  "disabled": true
                },
                {
                  "key": "blitzOrderId",
                  "value": "{{blitzOrderId}}"
                }
              ]
            }
          },
          "response": []
        }
